# Sentinel Backend Environment Configuration
PROJECT_NAME="Sentinel Fraud Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Future Persistence (Supabase / Postgres)
# Do not fill credentials for local development. Sentinel uses local repository stubs when credentials are absent.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Authentication — Supabase Auth (ES256 / JWKS)
# Set SUPABASE_URL to your Supabase project URL (e.g., https://<project-ref>.supabase.co)
# Required for ES256/JWKS bearer-token verification on protected API routes.
# Leave blank to disable auth (server will return 503).
